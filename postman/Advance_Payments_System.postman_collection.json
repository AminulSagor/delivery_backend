{
  "info": {
    "name": "Advance Payments System",
    "description": "Full advance payment workflow collection covering admin creation, merchant approval, merchant review requests, admin review handling, legacy admin pay, and the merchant advance-payment toggle.\n\nProper flow:\n1. Admin creates an advance invoice.\n2. Merchant reviews the invoice.\n3. If the invoice is correct, the merchant approves it.\n4. Merchant approval automatically deducts the balance and marks the invoice as paid.\n5. If the merchant sees a mismatch, they request review with a note.\n6. Admin reviews the request, adjusts the invoice or rejects it.\n7. The updated invoice returns to merchant approval.\n8. When the merchant approves the updated invoice, the balance is deducted automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "merchant_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "merchantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "advancePaymentId",
      "value": "",
      "type": "string"
    }
  ],
