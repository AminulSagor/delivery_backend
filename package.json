{
  "name": "delivery",
  "version": "0.0.1",
  "description": "Delivery Backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "test:railway": "node test-railway-connection.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "typeorm:prod": "echo 'Migrations run automatically on app start via migrationsRun option'",
    "typeorm:migrate": "npm run build && npm run typeorm migration:run",
    "typeorm:migrate:prod": "echo 'Migrations run automatically on app start via migrationsRun option'",
    "typeorm:revert": "npm run build && npm run typeorm migration:revert",
    "typeorm:generate": "npm run typeorm migration:generate",
    "export:locations": "ts-node -r tsconfig-paths/register scripts/export-carrybee-locations.ts",
    "import:coverage": "ts-node -r tsconfig-paths/register scripts/import-coverage-areas.ts",
    "migrate:coverage": "ts-node -r tsconfig-paths/register scripts/migrate-and-import-coverage.ts",
    "wait-for-db": "node scripts/wait-for-db.js",
    "fix:typeorm-metadata": "node scripts/fix-typeorm-metadata.js",
    "fix:payout-methods": "node scripts/fix-method-type-enum.js",
    "fix:delivery-verifications": "node scripts/fix-delivery-verifications.js",
    "fix:sync-schema": "node scripts/sync-schema.js",
    "fix:all-enums": "node scripts/fix-all-enums.js",
    "fix:all-columns": "node scripts/add-all-missing-columns.js",
    "fix:all": "npm run fix:typeorm-metadata && npm run fix:all-enums && npm run fix:all-columns",
    "railway:deploy": "node scripts/start-with-migrations.js",
    "railway:diagnose": "node scripts/railway-db-diagnostic.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml up --build",
    "start:worker": "ts-node -r tsconfig-paths/register scripts/run-carrybee-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.966.0",
    "@aws-sdk/s3-request-presigner": "^3.966.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "bwip-js": "^4.11.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
